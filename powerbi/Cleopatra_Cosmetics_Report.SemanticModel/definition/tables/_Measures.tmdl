		lineageTag: 777634a4-ae7f-53fa-bbab-d3b254ffc42b

	measure 'Target Variance' = ```
			VAR Actuals = [Actual Sales]
			VAR Target = [Sales Target]
			RETURN
			    IF(
			        NOT ISBLANK(Actuals) || NOT ISBLANK(Target),
			        Actuals - Target,
			        BLANK()
			    )
		```
		formatString: +#,##0.00 "EGP";-#,##0.00 "EGP";0.00 "EGP"
		displayFolder: 04 Commercial Targets
		lineageTag: 68d35f09-c91e-5e88-afae-e9053188f051

	measure 'Target Variance %' = ```
			VAR Actuals = [Actual Sales]
			VAR Target = [Sales Target]
			RETURN
			    IF(
			        NOT ISBLANK(Target) && Target > 0,
			        DIVIDE(Actuals - Target, Target, 0),
			        BLANK()
			    )
		```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Commercial Targets
		lineageTag: 54da2f77-9eb4-5959-a9c6-dca2afdf23f6

	measure 'Target Achievement %' = DIVIDE([Actual Sales], [Sales Target], 0)
