	measure 'Total Raw Orders Ingested' = [Valid Orders] + [Quarantined Orders]
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 18a483e8-044a-5c4d-804b-30b7be4daf67

	measure 'Valid Orders' = COUNTROWS(fact_sales)
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 70fcabe3-e04f-561f-b8ed-7813d552589e

	measure 'Quarantined Orders' = COUNTROWS(rejected_orders)
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 4744e71e-f47e-53b5-9d4d-105a0731167c

	measure 'Data Quality Score %' = DIVIDE([Valid Orders], [Total Raw Orders Ingested], 0)
		formatString: 0.00%
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 1ccef3b2-4e6a-54bb-b1e1-720521aa5eb7

	measure 'DQ Rejection Rate %' = DIVIDE([Quarantined Orders], [Total Raw Orders Ingested], 0)
		formatString: 0.00%
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 71576af0-6012-5a14-a5fd-6c8827bd3080

	measure 'Reconciliation Variance Orders' = ```
			VAR TotalSource = [Valid Orders] + [Quarantined Orders]
			VAR ExpectedRaw = 502000
			RETURN
			    TotalSource - ExpectedRaw
		```
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 837b00d4-e779-5503-8d5e-86f1bff2158c

	measure 'Assertion 01 - Negative Sales Breach' = ```
			CALCULATE(
			    COUNTROWS(fact_sales),
			    fact_sales[net_sales_egp] < 0
			) + 0
		```
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 7c2ec5eb-f213-5aa1-b307-ed4ff30043df

	measure 'Assertion 02 - Orphan Customer Keys' = ```
			CALCULATE(
			    COUNTROWS(fact_sales),
			    ISBLANK(RELATED(dim_customer[customer_id]))
			) + 0
		```
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: cec7a7fd-e3fb-58e1-b949-853d8f0404da

	measure 'Assertion 03 - Date Dimension Gaps' = ```
			VAR MinDate = MIN(dim_date[Date])
			VAR MaxDate = MAX(dim_date[Date])
			VAR ExpectedDays = DATEDIFF(MinDate, MaxDate, DAY) + 1
			VAR ActualDays = COUNTROWS(dim_date)
			RETURN
			    ExpectedDays - ActualDays
		```
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: 75e92b15-a753-5165-9be4-159f9d324244

	measure 'Assertion 04 - Negative Damaged Stock' = ```
			CALCULATE(
			    COUNTROWS(fact_inventory),
			    fact_inventory[damaged_qty] < 0
			) + 0
		```
		formatString: #,##0
		displayFolder: 07 Data Quality & Pipeline Audit
		lineageTag: b5053284-190d-52b8-9cac-3352c617d1c5

