	measure Customers = DISTINCTCOUNT(fact_sales[CustomerKey])
		formatString: #,##0
		displayFolder: 03 Customer & AOV
		lineageTag: 114f09bd-30e5-5d23-86be-9c4e96190d83

	measure 'Customer Revenue' = DIVIDE([Net Sales], [Customers], 0)
		formatString: #,##0.00 "EGP"
		displayFolder: 03 Customer & AOV
		lineageTag: 92d499fd-3d7a-587b-be68-023971be1068

	measure 'New Customers' = ```
			VAR MinDates = 
			    ADDCOLUMNS(
			        VALUES(dim_customer[CustomerKey]),
			        "@FirstPurchase", CALCULATE(MIN(fact_sales[order_datetime]), ALL(dim_date))
			    )
			VAR CurrentPeriodStart = MIN(dim_date[Date])
			VAR CurrentPeriodEnd = MAX(dim_date[Date])
			RETURN
			    COUNTROWS(
			        FILTER(
			            MinDates,
			            VAR FP = [@FirstPurchase]
			            RETURN FP >= CurrentPeriodStart && FP <= CurrentPeriodEnd
			        )
			    ) + 0
		```
		formatString: #,##0
		displayFolder: 03 Customer & AOV
		lineageTag: 68d97b0e-ee07-50a7-945e-3b839ce7fce6

	measure 'Returning Customers' = [Customers] - [New Customers]
		formatString: #,##0
		displayFolder: 03 Customer & AOV
		lineageTag: d07819ef-9a5d-5258-bc32-852b94dd9c3f

	measure 'Customer Last Order Date' = ```
			CALCULATE(
			    MAX(fact_sales[order_datetime]),
			    fact_sales[order_status] = "Completed"
			)
		```
		displayFolder: 03 Customer & AOV
		lineageTag: 032932cf-2dc8-5daf-a183-7018e06e1655

	measure 'Customer Recency Days' = ```
			VAR LastOrder = [Customer Last Order Date]
			VAR AsOfDate = MAX(dim_date[Date])
			RETURN
			    IF(
			        NOT ISBLANK(LastOrder),
			        DATEDIFF(LastOrder, AsOfDate, DAY),
			        BLANK()
			    )
		```
		displayFolder: 03 Customer & AOV
		lineageTag: 7a7cb1c7-5c7b-57be-a651-84bdc303081b

	measure 'Customer Frequency' = CALCULATE(
		displayFolder: 03 Customer & AOV
		lineageTag: 4f078e0e-610a-5f60-a0ac-f1f25282047b

	measure 'Customer Monetary' = CALCULATE(
		displayFolder: 03 Customer & AOV
		lineageTag: 7b2775ce-d1c8-58db-8d2d-043ecf6a6f28

	measure 'Customer RFM Segment' = ```
			VAR R_Days = [Customer Recency Days]
			VAR F_Count = [Customer Frequency]
			VAR M_Spend = [Customer Monetary]

			VAR R_Score = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(R_Days), BLANK(),
			        R_Days <= 45, 5,
			        R_Days <= 90, 4,
			        R_Days <= 150, 3,
			        R_Days <= 240, 2,
			        1
			    )

			VAR F_Score = 
			    SWITCH(
			        TRUE(),
			        F_Count >= 28, 5,
			        F_Count >= 20, 4,
			        F_Count >= 14, 3,
			        F_Count >= 8, 2,
			        1
			    )

			VAR M_Score = 
			    SWITCH(
			        TRUE(),
			        M_Spend >= 24000, 5,
			        M_Spend >= 17000, 4,
			        M_Spend >= 11500, 3,
			        M_Spend >= 6000, 2,
			        1
			    )

			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(R_Score), "No Orders",
			        R_Score >= 4 && F_Score >= 4 && M_Score >= 4, "Champions",
			        R_Score >= 3 && F_Score >= 3 && M_Score >= 3, "Loyal Customers",
			        R_Score >= 4 && F_Score <= 2, "Potential Loyalists",
			        R_Score <= 3 && F_Score >= 3 && M_Score >= 3, "At Risk",
			        R_Score == 1 && F_Score <= 2, "Lost Customers",
			        "Hibernating"
			    )
		```
		displayFolder: 03 Customer & AOV
		lineageTag: b9028c37-cf03-5258-8329-1bb0f50f1485

	measure 'RFM Customer Count' = ```
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customer[CustomerKey]),
			        NOT ISBLANK([Customer RFM Segment])
			    )
			)
		```
		formatString: #,##0
		displayFolder: 03 Customer & AOV
		lineageTag: fd3839eb-934f-5bf2-a6e2-3ca93aa8a8c3

	measure 'Sales Target' = SUM(fact_targets[sales_target_egp])
		formatString: #,##0.00 "EGP"
		displayFolder: 04 Commercial Targets
