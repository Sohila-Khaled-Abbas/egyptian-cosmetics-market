table dim_geography
	lineageTag: 755a9310-0948-55dd-a71d-4ce8199af782

	column GeographyKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 741e62e4-c014-5880-8f92-0c966e9dcd42
		summarizeBy: none
		sourceColumn: GeographyKey

	column 'Governorate EN'
		dataType: string
		lineageTag: eb6b016c-6f00-5199-a8f3-8ac76f6474b0
		summarizeBy: none
		sourceColumn: 'Governorate EN'

	column 'Governorate AR'
		dataType: string
		lineageTag: 12c115a0-98da-572f-96ec-37012150915d
		summarizeBy: none
		sourceColumn: 'Governorate AR'

	column 'Economic Region EN'
		dataType: string
		lineageTag: c7476b07-2777-5ade-9c6e-b576be1d8f54
		summarizeBy: none
		sourceColumn: 'Economic Region EN'

	column 'Economic Region AR'
		dataType: string
		lineageTag: c8a32840-6862-52ac-89cd-8f838defb0a9
		summarizeBy: none
		sourceColumn: 'Economic Region AR'

	column 'Distribution Region EN'
		dataType: string
		lineageTag: 389dc452-282a-5a26-8c08-caa949d68e3a
