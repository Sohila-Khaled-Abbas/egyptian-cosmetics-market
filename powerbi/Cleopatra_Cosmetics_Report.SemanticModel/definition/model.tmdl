model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ar-EG
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '00_Parameters & Functions'
	annotation PBI_QueryGroupOrder = 0

queryGroup 01_Source
	annotation PBI_QueryGroupOrder = 1

queryGroup 02_Staging
	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Reference
	annotation PBI_QueryGroupOrder = 3

queryGroup 04_Cleansed
	annotation PBI_QueryGroupOrder = 4

queryGroup 05_Validated
	annotation PBI_QueryGroupOrder = 5

queryGroup 06_Transformations
	annotation PBI_QueryGroupOrder = 6

queryGroup 07_Model
	annotation PBI_QueryGroupOrder = 7

queryGroup 99_Admin
	annotation PBI_QueryGroupOrder = 8

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table fact_sales
ref table fact_inventory
ref table fact_targets
ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_store
ref table dim_geography
ref table dim_category
ref table dim_subcategory
ref table dim_campaign
ref table dim_channel
ref table dim_payment_method
ref table dim_order_status
ref table rejected_orders
ref table rejected_customers
ref table rejected_inventory
ref table rejected_targets
ref table customer_duplicate_analysis
ref table dq_summary
ref table refresh_metadata

ref cultureInfo en-US
