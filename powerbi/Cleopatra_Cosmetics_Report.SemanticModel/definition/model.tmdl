model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '00_Parameters & Functions'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pRawDataPath","pStartDate","pEndDate","fnCleanText","fnNormalizeCurrency","fnNormalizeStatus","fnStandardizeGovernorate","fnValidatePositiveNumber"]

annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo en-US

