model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ar-EG
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '00_Parameters & Functions'

	annotation PBI_QueryGroupOrder = 0

queryGroup 01_Source

	annotation PBI_QueryGroupOrder = 1

queryGroup 02_Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Reference

	annotation PBI_QueryGroupOrder = 3

queryGroup 04_Cleansed

	annotation PBI_QueryGroupOrder = 4

queryGroup 05_Validated

	annotation PBI_QueryGroupOrder = 5

queryGroup 06_Transformations

	annotation PBI_QueryGroupOrder = 6

queryGroup 07_Model

	annotation PBI_QueryGroupOrder = 7

queryGroup 99_Admin

	annotation PBI_QueryGroupOrder = 8

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pRawDataPath","pStartDate","pEndDate","fnCleanText","fnNormalizeCurrency","fnNormalizeStatus","fnStandardizeGovernorate","fnValidatePositiveNumber","src_customers","src_products","src_stores","src_orders","src_inventory","src_excel_workbook","src_targets","src_campaigns","src_exchange_rates"]

annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo en-US

